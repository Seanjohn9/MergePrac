@model MVC_Project.Models.StudentModel




<style>
    body {
        background-image: url('/img/SteamLibrary2.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed; 
        background-repeat: no-repeat;
    }
</style>

    <div id="member"> <h1 class="display-4" style="color: white;">@ViewBag.WelcomeMessage</h1> </div>


    <img src="/img/ME.jpg" alt="Winrev" width="200" height="200" style="border: 5px solid #04D9FF; margin-top: 45px;">


<div id="Name">
    <p><strong style="color: white;">Full Name:</strong> @Model.FullName</p>
    <p><strong style="color: white;">Hobbies:</strong> @Model.Hobbies</p>
    <p><strong style="color: white;">BirthDate:</strong> @Model.BirthDate</p>

    <h3 style="color: white; margin-top: 15px;">About Me:</h3>
    <p> 

        Hello! My name is Winrev, and I enjoy technology and learning new things. In my free time, I like playing video games and watching anime. I'm also interested 
        in coding and learning how programs work. One of my goals
        is to make a video game someday. Aside from that, I enjoy learning 
        about PC hardware, computer parts, and how everything works together. 
        There's still a lot I want to learn, especially when it comes to technology and game development. I hope that I can keep improving 
        my skills and eventually turn my interests into something I can create and share with other people.


    
    </h3>
    </div>

    </p>
</div>
     

