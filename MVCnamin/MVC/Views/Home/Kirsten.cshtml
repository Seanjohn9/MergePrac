@model MVC.Models.StudentModel;
<link rel="stylesheet" href="~/css/Kirsten.css" asp-append-version="true" />


<h1 class="display-1 text-center"><i>ABOUT MEMBER 2!</i><br/></h1>

  <div class="container">
     <div class="description">
